# Set to "production" for a live deployment. Among other things this makes
# BTCPayProvider fail the checkout (instead of just warning) if the BTCPay
# instance hands back a non-mainnet Bitcoin address — see
# docs/btcpay-mainnet-runbook.md.
APP_ENV=development

# Docker Compose service hostnames (postgres, redis). Point at localhost
# instead when running the API outside of Docker.
DATABASE_URL=postgresql+asyncpg://rapidfinil:rapidfinil_dev_password@postgres:5432/rapidfinil
REDIS_URL=redis://redis:6379/0

# Only used by the postgres container itself (see compose.yaml). Must match
# the credentials embedded in DATABASE_URL above.
POSTGRES_DB=rapidfinil
POSTGRES_USER=rapidfinil
POSTGRES_PASSWORD=rapidfinil_dev_password

# BTCPay Server — real crypto payment provider (see
# app/integrations/payments/btcpay.py and backend/README.md). Leave blank to
# fall back to the fake payment provider for local dev/CI. For a live mainnet
# store (spendable bc1… addresses, not regtest bcrt1…), follow
# docs/btcpay-mainnet-runbook.md.
BTCPAY_BASE_URL=
# Only needed if the customer-facing checkout link differs from
# BTCPAY_BASE_URL — e.g. local regtest, where the backend calls BTCPay over
# an internal Docker hostname (http://btcpayserver:49392) but the browser
# needs the host-mapped http://localhost:23000 instead. Leave blank when
# BTCPAY_BASE_URL is already reachable from the browser (a real deployment).
BTCPAY_PUBLIC_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Phase 10 admin panel — a single shared secret gates every /admin/* route
# (see app/api/v1/deps.py::require_admin). There's no per-operator login
# yet (Phase 2 auth was never built), so treat this like a root password:
# long, random, and never committed. Blank means the panel refuses all
# requests rather than silently allowing them.
ADMIN_API_KEY=
