APP_ENV=development

# Docker Compose service hostnames (postgres, redis). Point at localhost
# instead when running the API outside of Docker.
DATABASE_URL=postgresql+asyncpg://rapidfinil:rapidfinil_dev_password@postgres:5432/rapidfinil
REDIS_URL=redis://redis:6379/0

# Only used by the postgres container itself (see compose.yaml). Must match
# the credentials embedded in DATABASE_URL above.
POSTGRES_DB=rapidfinil
POSTGRES_USER=rapidfinil
POSTGRES_PASSWORD=rapidfinil_dev_password
